# Database
DATABASE_URL=postgresql+asyncpg://bridge:bridge_secret@db:5432/bridge
POSTGRES_DB=bridge
POSTGRES_USER=bridge
POSTGRES_PASSWORD=bridge_secret

# Redis
# 비밀번호는 docker-compose.yml 의 redis requirepass 기본값(bridge_redis_secret)과 동일해야 한다.
# 다른 값으로 바꾸려면 compose 를 REDIS_PASSWORD 로 오버라이드하고 아래 URL 도 함께 맞춘다.
REDIS_URL=redis://:bridge_redis_secret@redis:6379/0

# JWT
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Encryption (AES-256-GCM) — 32 bytes base64
ENCRYPTION_KEY=base64_encoded_32_bytes_key_here

# Chat (AI 챗봇 게이트웨이 — Mindlogic)
MINDLOGIC_API_KEY=

# CORS 허용 origin (콤마 구분). 개발은 * 로 충분, 운영은 명시 origin 지정.
CORS_ORIGINS=*

# App
APP_ENV=development
APP_DEBUG=true
