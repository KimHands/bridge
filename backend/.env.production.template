# Database (RDS PostgreSQL)
# DATABASE_URL 형식: postgresql+asyncpg://{USER}:{PASSWORD}@{RDS_ENDPOINT}:5432/{DB_NAME}
DATABASE_URL=postgresql+asyncpg://bridge:CHANGE_ME@CHANGE_ME.rds.amazonaws.com:5432/bridge
POSTGRES_DB=bridge
POSTGRES_USER=bridge
POSTGRES_PASSWORD=CHANGE_ME

# Redis (EC2 로컬 컨테이너)
REDIS_URL=redis://redis:6379/0

# JWT
# 생성: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Encryption (AES-256-GCM) — 32바이트 base64 인코딩
# 생성: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME

# App
APP_ENV=production
APP_DEBUG=false

# CORS — 운영에서는 와일드카드('*')가 무시되므로 허용할 origin을 콤마로 명시한다.
# 예: https://app.bridge.app,https://admin.bridge.app
CORS_ORIGINS=CHANGE_ME

# 챗봇(마인드로직 게이트웨이) — AI 챗봇 사용 시 필수
MINDLOGIC_API_KEY=CHANGE_ME
